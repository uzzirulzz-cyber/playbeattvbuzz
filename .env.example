# ─── PLAYBEATTV production environment ───
# PostgreSQL connection (Neon / Supabase / RDS / self-hosted)
DATABASE_URL="postgresql://user:password@host:5432/playbeattv?sslmode=require"

# Auth — generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"

# Payment webhook HMAC secret — generate with: openssl rand -base64 32
PAYMENTS_WEBHOOK_SECRET="change-me-too"
