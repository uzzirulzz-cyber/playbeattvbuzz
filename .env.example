# ─── PLAYBEATTV production environment ───
# PostgreSQL connection (Neon / Supabase / RDS / self-hosted)
DATABASE_URL="postgresql://user:password@host:5432/playbeattv?sslmode=require"

# Auth — generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"

# Payment webhook HMAC secret — generate with: openssl rand -base64 32
PAYMENTS_WEBHOOK_SECRET="change-me-too"

# ─── Xtream Masters reseller API (your IPTV provider) ───
XTREAM_API_KEY="your-reseller-api-key"
XTREAM_API_URL="https://iptv-api.xtream-masters.com/v3/"
XTREAM_PORTAL_HOST="portal.playbeattv.buzz"
# Optional — only if your reseller agreement permits adult packages (default OFF)
# XTREAM_ALLOW_ADULT=1
